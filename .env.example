# ─────────────────────────────────────────
# 🗄️ PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=vet_user
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=vet_clinic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─────────────────────────────────────────
# 🤖 Google Gemini
# ─────────────────────────────────────────
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─────────────────────────────────────────
# 🔍 LangSmith (observabilidade)
# ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=sua_langsmith_api_key_aqui
LANGCHAIN_PROJECT=vet-clinic-agent

# ─────────────────────────────────────────
# 📱 WhatsApp — Evolution API (dev)
# ─────────────────────────────────────────
WHATSAPP_PROVIDER=evolution               # trocar para "meta" em produção
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_evolution_api_key_aqui
EVOLUTION_INSTANCE=vet_clinic

# ─────────────────────────────────────────
# 📱 WhatsApp — Meta Cloud API (produção)
# ─────────────────────────────────────────
META_WHATSAPP_TOKEN=seu_token_meta_aqui
META_PHONE_NUMBER_ID=seu_phone_number_id_aqui
META_VERIFY_TOKEN=token_verificacao_webhook

# ─────────────────────────────────────────
# 📅 Google Calendar + Gmail
# ─────────────────────────────────────────
GOOGLE_CREDENTIALS_JSON=./credentials/google_credentials.json
GOOGLE_TOKEN_JSON=./credentials/google_token.json

# ─────────────────────────────────────────
# 📧 E-mail (SMTP fallback)
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clinica@gmail.com
SMTP_PASSWORD=sua_senha_app_gmail

# ─────────────────────────────────────────
# ⚙️ Aplicação
# ─────────────────────────────────────────
APP_ENV=development                       # trocar para "production"
APP_SECRET_KEY=chave_secreta_aleatoria
RAG_FILES_PATH=/rag_files
